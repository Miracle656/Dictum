# Copy to .env and fill in. Never commit .env.

# --- RPC endpoints (public defaults are rate-limited; use Alchemy/QuickNode/etc. for anything real)
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# --- Agent signer (testnet only until the flow passes twice). Leave blank for read-only quoting.
AGENT_PRIVATE_KEY=

# --- LLM explanation layer (never touches money maths)
ANTHROPIC_API_KEY=

# --- Set to 1 to run integration tests that hit live RPCs
LIVE_TESTS=0
